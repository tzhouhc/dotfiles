{
  "root": "$HOME",
  "extra_roots": ["/Applications", "/System/Applications"],
  "live_roots": ["$HOME/Pictures"],
  "skip_paths": ["$HOME/Library"],
  "ignore_extra": ["*~", ".mypycache", "%*", "Icon*"],
  "image_preview": "ansi",
  "preview_cmd": "$HOME/.dotfiles/sbin/smart_preview {} {h} {w}",
  "folder_preview_cmd": "$HOME/.dotfiles/sbin/smart_preview {}",
  "accent_color": "#7aa2f7",
  "dim_color": "#565f89",
  "prompt": "➜",
  "calc_cmd": "/opt/homebrew/bin/numbat -e {}"
}
